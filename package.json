{
  "name": "fenjingtai",
  "productName": "分镜台",
  "version": "2.0.5",
  "description": "口播稿逐句分镜标注工具",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/production-test.mjs && node scripts/collab-test.mjs && node scripts/main-test.mjs && node scripts/crash-test.mjs && node scripts/test.mjs",
    "test:ui": "node scripts/test.mjs",
    "test:theme": "node scripts/theme-test.mjs",
    "test:data": "node scripts/production-test.mjs && node scripts/collab-test.mjs && node scripts/main-test.mjs && node scripts/crash-test.mjs",
    "test:collab": "node scripts/collab-e2e.mjs",
    "test:crash": "node scripts/crash-test.mjs && node scripts/crash-e2e.mjs",
    "lint": "node scripts/architecture-check.mjs && eslint .",
    "format": "prettier --write \"electron/**/*.js\" \"renderer/**/*.{js,css,html}\" \"scripts/**/*.mjs\"",
    "repack": "node scripts/repack.mjs",
    "package": "node scripts/package.mjs",
    "install-local": "node scripts/install-local.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "electron": "^44.4.5",
    "eslint": "^10.11.0",
    "espree": "^11.2.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "puppeteer-core": "^25.12.0"
  }
}
